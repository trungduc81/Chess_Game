# Cấu hình kết nối client tới server. Không hiển thị trên giao diện.
CHESS_SERVER_HOST=127.0.0.1
CHESS_SERVER_PORT=5555

# MySQL phía server.
CHESS_DB_URL=jdbc:mysql://localhost:3306/btl_chess?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
CHESS_DB_USER=root
CHESS_DB_PASSWORD=your_mysql_password

# Tài khoản quản trị được tạo/cập nhật khi Server khởi động.
# Chỉ tạo Admin khi cả hai giá trị đều được cấu hình, không commit mật khẩu thật.
CHESS_ADMIN_USERNAME=
CHESS_ADMIN_PASSWORD=

# Thời gian tính bằng giây.
CHESS_MOVE_TIMEOUT_SECONDS=30
CHESS_HEARTBEAT_INTERVAL_SECONDS=5
CHESS_HEARTBEAT_TIMEOUT_SECONDS=15
